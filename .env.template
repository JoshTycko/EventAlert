# EventAlert - Generic Event Ticket Notifier Configuration
# Copy this to .env and fill in your actual values

# Email configuration for notifications
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com

# SMTP settings (Gmail example - adjust for your provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com

# For Gmail, use an App Password instead of your regular password
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password

# Optional: SMS notifications via Twilio (sign up at twilio.com)
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE_FROM=+1234567890
# TWILIO_PHONE_TO=+1234567890

# Optional: SMS via email-to-SMS gateway (free)
# Add your carrier's SMS email to EMAIL_TO above
# Verizon: yournumber@vtext.com
# AT&T: yournumber@txt.att.net
# T-Mobile: yournumber@tmomail.net
